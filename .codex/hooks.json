{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/eslint.py\"",
            "timeout": 60,
            "statusMessage": "Checking edited TypeScript files with ESLint"
          }
        ]
      }
    ]
  }
}
